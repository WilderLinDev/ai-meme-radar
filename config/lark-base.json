{
  "base_name": "AI视频梗数据库",
  "base_timezone": "America/Los_Angeles",
  "notes": [
    "Each table reads one source (see src/radar/export/lark.py SOURCES); each field's `from` is a source column, `map` translates values.",
    "Dedupe key = the listed fields' display values joined with |. Do not change it for a table that already has rows.",
    "URL fields are written as {link, text}. Dates are ms at 00:00 in base_timezone. Number formatter must be 0, 0.0 or 0.00.",
    "create_records takes an inlined JSON array, at most 500 per call; batches are 40 records. Do not delete or rename the empty default table."
  ],
  "tables": [
    {
      "key": "cc_rank_snapshot",
      "name": "CC榜单快照",
      "source": "cc_top100",
      "dedupe": [
        "抓取日期",
        "地区",
        "周期",
        "排名",
        "话题"
      ],
      "fields": [
        {
          "field_name": "去重键",
          "type": 1
        },
        {
          "field_name": "抓取日期",
          "type": 5,
          "property": {
            "date_formatter": "yyyy-MM-dd",
            "auto_fill": false
          },
          "from": "capture_date"
        },
        {
          "field_name": "地区",
          "type": 3,
          "property": {
            "options": [
              {
                "name": "US"
              },
              {
                "name": "GB"
              },
              {
                "name": "AU"
              },
              {
                "name": "CA"
              },
              {
                "name": "DE"
              },
              {
                "name": "JP"
              },
              {
                "name": "KR"
              },
              {
                "name": "FR"
              },
              {
                "name": "NL"
              }
            ]
          },
          "from": "region"
        },
        {
          "field_name": "行业",
          "type": 1,
          "from": "industry"
        },
        {
          "field_name": "周期",
          "type": 3,
          "property": {
            "options": [
              {
                "name": "7日"
              },
              {
                "name": "30日"
              }
            ]
          },
          "from": "period",
          "map": {
            "7": "7日",
            "30": "30日"
          }
        },
        {
          "field_name": "排名",
          "type": 2,
          "property": {
            "formatter": "0"
          },
          "from": "rank"
        },
        {
          "field_name": "话题",
          "type": 1,
          "from": "hashtag"
        },
        {
          "field_name": "发帖数",
          "type": 2,
          "property": {
            "formatter": "0"
          },
          "from": "posts"
        },
        {
          "field_name": "播放量",
          "type": 2,
          "property": {
            "formatter": "0"
          },
          "from": "views"
        },
        {
          "field_name": "排名变化",
          "type": 2,
          "property": {
            "formatter": "0"
          },
          "from": "rank_change"
        },
        {
          "field_name": "详情ID",
          "type": 1,
          "from": "detail_id"
        },
        {
          "field_name": "详情链接",
          "type": 15,
          "from": "detail_url"
        }
      ]
    },
