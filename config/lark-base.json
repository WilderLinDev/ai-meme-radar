        {
          "field_name": "D+3日期",
          "type": 5,
          "property": {
            "date_formatter": "yyyy-MM-dd",
            "auto_fill": false
          },
          "from": "d3_date"
        },
        {
          "field_name": "D+3值",
          "type": 2,
          "property": {
            "formatter": "0.00"
          },
          "from": "d3_value"
        },
        {
          "field_name": "结果",
          "type": 3,
          "property": {
            "options": [
              {
                "name": "对"
              },
              {
                "name": "错"
              },
              {
                "name": "待定"
              },
              {
                "name": "数据不足"
              }
            ]
          },
          "from": "result",
          "map": {
            "hit": "对",
            "miss": "错",
            "pending": "待定",
            "insufficient": "数据不足"
          }
        },
        {
          "field_name": "说明",
          "type": 1,
          "from": "note"
        },
        {
          "field_name": "结论卡一句",
          "type": 1,
          "from": "line_zh"
        }
      ]
    },
