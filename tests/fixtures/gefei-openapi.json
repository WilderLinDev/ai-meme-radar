    "tags": [
     "数据服务"
    ],
    "parameters": [
     {
      "name": "page",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 1,
       "maximum": 180143985094819,
       "default": 1,
       "description": "页码，默认1，每页最多50个网站；递增至 has_more=false。"
      }
     },
     {
      "name": "month",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
       "description": "报告月份 YYYY-MM。"
      }
     },
     {
      "name": "28d",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "format": "date",
