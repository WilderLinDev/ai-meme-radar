  "/api/v1/keywords": {
   "get": {
    "operationId": "keyword_search",
    "summary": "关键词搜索",
    "tags": [
     "数据服务"
    ],
    "parameters": [
     {
      "name": "q",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 60,
       "description": "关键词，最多 60 字符；留空不筛选。"
      }
     },
     {
      "name": "tab",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "enum": [
        "new",
        "resurgence",
        "evergreen",
        "game",
        "all",
        "skip"
       ],
       "description": "分类。new：新词；resurgence：二次爆火；evergreen：长期大词；game：游戏；all：全部（排除不值得做）；skip：不值得做。默认不筛选，包含不值得做。"
      }
     },
     {
      "name": "page",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 1,
       "maximum": 180143985094819,
       "default": 1,
       "description": "页码，默认 1；超出末页返回空列表。"
      }
     }
    ]
   }
  },
  "/api/v1/keywords/word/{slug}": {
   "get": {
    "operationId": "keyword_detail",
