  "/api/v1/launches": {
   "get": {
    "operationId": "launch_search",
    "summary": "新站搜索",
    "tags": [
     "数据服务"
    ],
    "parameters": [
     {
      "name": "q",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 60,
       "description": "搜索标题、域名、用途或目标关键词，最多 60 字符；留空不筛选。"
      }
     },
     {
      "name": "type",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "enum": [
        "site",
        "repo",
        "all"
       ],
       "default": "site",
       "description": "类型，默认 site。site：网站和应用；repo：开源仓库；all：全部。"
      }
     },
     {
      "name": "motive",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "enum": [
        "keyword",
        "own_need",
        "others_need",
        "hobby",
        "business",
        "unknown"
       ],
       "description": "开发动机，默认不筛选。keyword：关键词需求；own_need：自身需求；others_need：他人需求；hobby：兴趣；business：商业机会；unknown：未说明。"
      }
     },
     {
      "name": "page",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 1,
       "maximum": 180143985094819,
       "default": 1,
       "description": "页码，默认 1；超出末页返回空列表。"
      }
     }
    ]
   }
  },
